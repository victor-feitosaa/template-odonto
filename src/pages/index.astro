---
import Layout from "@layouts/Layout.astro";
import Header from "@components/ui/Header.astro";
import Hero from "@components/ui/Hero.astro";
import Services from "@components/ui/Services.astro";
import Differentials from "@components/ui/Differentials.astro";
import Testimonials from "@components/ui/Testimonials.astro";
import CtaBanner from "@components/ui/CtaBanner.astro";
import FaqSection from "@components/react/FaqSection";
import Contact from "@components/ui/Contact.astro";
import Footer from "@components/ui/Footer.astro";
import WhatsAppFab from "@components/ui/WhatsAppFab.astro";
import LocalBusinessJsonLd from "@components/seo/LocalBusinessJsonLd.astro";
---

<Layout>
  <LocalBusinessJsonLd />

  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:bg-teal-700 focus:text-white focus:px-4 focus:py-2 focus:rounded"
  >
    Pular para o conteúdo
  </a>

  <Header />

  <main id="main">
    <Hero />
    <Services />
    <Differentials />
    <Testimonials />
    <CtaBanner />
    <FaqSection client:visible />
    <Contact />
  </main>

  <Footer />
  <WhatsAppFab />
</Layout>