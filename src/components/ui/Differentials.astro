---
import { DIFFERENTIALS } from "@data/content";
---

<section id="diferenciais" class="py-24 bg-teal-950 text-white">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid md:grid-cols-[1fr_1.5fr] gap-16 items-start">
      <div>
        <span class="text-xs font-medium tracking-widest uppercase text-teal-400">
          Por que nos escolher
        </span>
        <h2 class="font-display text-4xl lg:text-5xl text-white mt-3 leading-tight">
          Saúde bucal com<br />
          <em class="text-teal-400">conforto e</em><br />
          precisão
        </h2>
        <div class="mt-10 aspect-[4/3] rounded-2xl overflow-hidden bg-teal-900">
          <img
            src="https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?w=700&h=500&fit=crop&auto=format"
            alt="Consultório odontológico moderno com equipamentos de ponta"
            class="w-full h-full object-cover opacity-80"
            loading="lazy"
            width="700"
            height="500"
          />
        </div>
      </div>

      <div class="space-y-0 divide-y divide-teal-800/60">
        {DIFFERENTIALS.map((d) => (
          <div class="py-8 flex gap-6">
            <span class="font-display text-4xl text-teal-700 shrink-0 leading-none">
              {d.number}
            </span>
            <div>
              <h3 class="font-semibold text-lg text-white mb-2">{d.title}</h3>
              <p class="text-sm text-teal-300 leading-relaxed">{d.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>