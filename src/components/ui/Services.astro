---
import { SERVICES } from "@data/content";
import {
  Sparkles,
  Smile,
  CircleDot,
  Gem,
  Baby,
  ShieldCheck,
  ArrowRight,
} from "@lucide/astro";

const iconMap: Record<string, any> = {
  Sparkles,
  Smile,
  CircleDot,
  Gem,
  Baby,
  ShieldCheck,
};
---

<section id="servicos" class="py-24 bg-white">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid md:grid-cols-[1fr_2fr] gap-12 mb-16">
      <div>
        <span class="text-xs font-medium tracking-widest uppercase text-teal-600">
          Serviços
        </span>
        <h2 class="font-display text-4xl lg:text-5xl text-teal-950 mt-3 leading-tight">
          Tratamentos completos em um só lugar
        </h2>
      </div>
      <div class="flex items-end">
        <p class="text-neutral-500 text-base leading-relaxed max-w-md">
          Da prevenção à estética avançada, nossa equipe multiespecialista cuida
          de toda a saúde bucal da sua família com diagnóstico preciso e
          tecnologia de ponta.
        </p>
      </div>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {SERVICES.map((s) => {
        const Icon = iconMap[s.icon];
        return (
          <article class="group relative bg-sand-50 hover:bg-teal-700 rounded-2xl p-7 transition-all duration-300 cursor-default">
            {s.tag && (
              <span class="absolute top-5 right-5 text-[10px] font-semibold uppercase tracking-wider bg-teal-100 group-hover:bg-teal-600 text-teal-700 group-hover:text-white px-2.5 py-1 rounded-full transition-colors">
                {s.tag}
              </span>
            )}
            <Icon class="w-7 h-7 text-teal-600 group-hover:text-teal-200 transition-colors block mb-4" />
            <h3 class="font-semibold text-teal-950 group-hover:text-white text-lg mb-2 transition-colors">
              {s.name}
            </h3>
            <p class="text-sm text-neutral-500 group-hover:text-teal-100 leading-relaxed transition-colors">
              {s.desc}
            </p>
            <div class="mt-5 flex items-center gap-1 text-xs font-medium text-teal-600 group-hover:text-teal-200 transition-colors">
              Saiba mais
              <ArrowRight class="w-3 h-3" />
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>