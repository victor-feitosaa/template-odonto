---
import { SITE, STATS } from "@data/content";
import { Phone, ArrowRight } from "@lucide/astro";
import StarRating from "./StarRating.astro";
import WhatsAppIcon from "./WhatsAppIcon.astro";
---

<section class="relative pt-16 min-h-screen grid md:grid-cols-[1fr_1fr] overflow-hidden">
  <div class="flex flex-col justify-center px-8 md:px-16 lg:px-24 py-20 bg-sand-50">
    <div class="inline-flex items-center gap-2 mb-8">
      <span class="w-2 h-2 rounded-full bg-teal-600" />
      <span class="text-xs font-medium tracking-widest uppercase text-teal-700">
        Clínica Odontológica — {SITE.address.city}, {SITE.address.state}
      </span>
    </div>

    <h1 class="font-display text-5xl lg:text-6xl xl:text-7xl leading-[1.05] text-teal-950 mb-6">
      O sorriso que<br />
      <em class="text-teal-700 not-italic">você merece</em><br />
      está aqui.
    </h1>

    <p class="text-neutral-600 text-lg leading-relaxed max-w-md mb-10">
      Tratamentos odontológicos completos — clareamento, implantes, ortodontia e
      muito mais — com tecnologia de ponta e atendimento humanizado. Agende em
      menos de 2 minutos.
    </p>

    <div class="flex flex-wrap gap-3 mb-14">
      <a
        href="#contato"
        class="inline-flex items-center gap-2 bg-teal-700 hover:bg-teal-800 text-white font-semibold px-7 py-4 rounded-full text-base transition-all hover:shadow-lg hover:shadow-teal-700/20"
      >
        Agendar consulta grátis
        <ArrowRight class="w-4 h-4" />
      </a>
      <a
        href={`https://wa.me/${SITE.whatsapp}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 border border-sand-200 hover:border-teal-300 text-teal-900 font-medium px-7 py-4 rounded-full text-base transition-colors bg-white"
      >
        <WhatsAppIcon class="w-5 h-5 fill-teal-600" />
        WhatsApp
      </a>
    </div>

    <div class="flex gap-8 border-t border-sand-200 pt-8">
      {STATS.map((s) => (
        <div>
          <div class="font-display text-2xl text-teal-800">{s.value}</div>
          <div class="text-xs text-neutral-500 mt-0.5">{s.label}</div>
        </div>
      ))}
    </div>
  </div>

  <div class="relative hidden md:block bg-teal-100">
    <img
      src="https://images.unsplash.com/photo-1617812191081-2a24e3f30e45?q=80&w=687&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
      alt="mulher-com-cabelo-castanho-sorrindo"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
      width="900"
      height="1000"
    />
    <div class="absolute inset-0 bg-gradient-to-br from-teal-900/20 to-teal-950/10" />

    <div class="absolute bottom-10 left-10 bg-white rounded-2xl px-5 py-4 shadow-xl max-w-[220px]">
      <div class="flex items-center gap-2 mb-2">
        <StarRating count={5} />
        <span class="text-xs font-semibold text-teal-700">5.0</span>
      </div>
      <p class="text-xs text-neutral-600 leading-snug">
        "Melhor decisão que tomei. Me sinto muito mais confiante."
      </p>
      <p class="text-xs font-semibold text-neutral-800 mt-2">— Ana R., Google</p>
    </div>

    <div class="absolute top-10 right-10 bg-teal-800/90 backdrop-blur-sm text-white rounded-xl px-4 py-3 text-xs font-medium">
      ✓ {SITE.cro} Registrado
    </div>
  </div>
</section>