---
import { TESTIMONIALS } from "@data/content";
import StarRating from "./StarRating.astro";
---

<section id="depoimentos" class="py-24 bg-sand-50">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-14">
      <span class="text-xs font-medium tracking-widest uppercase text-teal-600">
        Depoimentos
      </span>
      <h2 class="font-display text-4xl lg:text-5xl text-teal-950 mt-3">
        O que nossos pacientes<br />
        falam sobre nós
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {TESTIMONIALS.map((t) => (
        <article class="bg-white rounded-2xl p-7 border border-sand-200 flex flex-col">
          <StarRating count={t.rating} />
          <blockquote class="text-neutral-700 text-sm leading-relaxed mt-4 mb-6 flex-1">
            "{t.text}"
          </blockquote>
          <footer class="flex items-center gap-3 border-t border-sand-100 pt-5">
            <img
              src={t.photo}
              alt={`Foto de ${t.name}`}
              class="w-10 h-10 rounded-full object-cover bg-teal-100"
              loading="lazy"
              width="40"
              height="40"
            />
            <div>
              <p class="text-sm font-semibold text-teal-950">{t.name}</p>
              <p class="text-xs text-neutral-500">{t.role}</p>
            </div>
          </footer>
        </article>
      ))}
    </div>

    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4 text-sm text-neutral-600">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" />
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05" />
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
        </svg>
        <strong class="text-teal-950">4,9 / 5,0</strong> no Google
      </div>
      <span class="hidden sm:block text-sand-200">|</span>
      <span>Mais de 340 avaliações verificadas</span>
    </div>
  </div>
</section>